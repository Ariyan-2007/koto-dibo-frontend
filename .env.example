# Copy this file to .env and fill in values for your machine.
# Vercel: set these same keys in Project Settings -> Environment Variables
# (scoped per Production / Preview / Development) instead of committing a .env file.

# Base URL the frontend calls for the API.
# - Leave unset in local dev to use the Vite dev-server proxy at /api (see API_PROXY_TARGET below).
# - In production, set this to your deployed backend's public URL, e.g. https://api.kotodibo.com/api
VITE_API_BASE_URL=

# Dev-server only: where the /api proxy forwards requests to (your local backend).
# Not exposed to the browser bundle, so it does not need the VITE_ prefix.
API_PROXY_TARGET=http://localhost:5047
