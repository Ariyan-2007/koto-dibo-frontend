# Copy this file to .env and fill in values for your machine.
# Vercel: set this same key in Project Settings -> Environment Variables
# (scoped per Production / Preview / Development) instead of committing a .env file.

# Origin the frontend calls for the API — no trailing slash, no /api suffix (that's hardcoded in
# src/lib/api/client.ts). Required; there is no dev-server proxy fallback.
# Local dev: point this at your local backend, e.g. http://localhost:5047
# Production: your deployed backend's public origin, e.g. https://koto-dibo-api.ariyan.app
VITE_API_BASE_URL=
